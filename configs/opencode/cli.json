{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": false,
  "mouse": true,
  "theme": {
    "name": "gruvbox"
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": true
  },
  "scroll": {
    "speed": 1,
    "acceleration": true
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5,
    "sound_pack": "opencode.default"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "off",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "keybinds": {
    "leader": "ctrl+space",
    "app.exit": "ctrl+c,<leader>q",
    "command.palette.show": "alt+p",
    "prompt.editor": "<leader>e",
    "theme.switch": "<leader>t",
    "opencode.status": "<leader>s",
    "variant.cycle": "ctrl+t",
    "messages.copy": "none",
    "model.list": "<leader>m",
    "model.cycle_recent": "none",
    "model.cycle_recent_reverse": "none",
    "model.cycle_favorite": "none",
    "model.cycle_favorite_reverse": "none",
    "agent.list": "none",
    "agent.cycle": "shift+tab",
    "agent.cycle.reverse": "none",
    "session.sidebar.toggle": "none",
    "session.toggle.scrollbar": "none",
    "session.export": "none",
    "session.new": "<leader>n",
    "session.list": "<leader>l",
    "session.timeline": "none",
    "session.fork": "none",
    "session.rename": "none",
    "session.share": "none",
    "session.unshare": "none",
    "session.interrupt": "escape",
    "session.compact": "<leader>c",
    "session.parent": "<leader>up,<leader>k",
    "session.line.up": "ctrl+up",
    "session.line.down": "ctrl+down",
    "session.half.page.up": "shift+up,ctrl+u",
    "session.half.page.down": "shift+down,ctrl+d",
    "session.first": "ctrl+shift+alt+up,alt+g",
    "session.last": "ctrl+shift+alt+down,alt+shift+g",
    "session.message.next": "ctrl+shift+down",
    "session.message.previous": "ctrl+shift+up",
    "session.messages_last_user": "none",
    "session.undo": "<leader>u",
    "session.redo": "<leader>r",
    "prompt.clear": "none",
    "prompt.paste": "none",
    "input.submit": "return",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.move.left": "left,ctrl+b",
    "input.move.right": "right,ctrl+f",
    "input.move.up": "up,ctrl+p",
    "input.move.down": "down,ctrl+n",
    "input.select.left": "none",
    "input.select.right": "none",
    "input.select.up": "none",
    "input.select.down": "none",
    "input.select.line.home": "none",
    "input.select.line.end": "none",
    "input.select.visual.line.home": "none",
    "input.select.visual.line.end": "none",
    "input.select.buffer.home": "none",
    "input.select.buffer.end": "none",
    "input.select.word.forward": "none",
    "input.select.word.backward": "none",
    "input.line.home": "ctrl+a",
    "input.line.end": "ctrl+e",
    "input.visual.line.home": "none",
    "input.visual.line.end": "none",
    "input.buffer.home": "none",
    "input.buffer.end": "none",
    "input.delete.line": "none",
    "input.delete.to.line.end": "ctrl+k",
    "input.delete.to.line.start": "ctrl+u",
    "input.backspace": "backspace",
    "input.delete": "none",
    "input.undo": "none",
    "input.redo": "none",
    "input.word.forward": "ctrl+right,ctrl+f",
    "input.word.backward": "ctrl+left,ctrl+b",
    "input.delete.word.forward": "none",
    "input.delete.word.backward": "ctrl+backspace",
    "prompt.history.previous": "up",
    "prompt.history.next": "down",
    "terminal.suspend": "none",
    "terminal.title.toggle": "none"
  }
}
