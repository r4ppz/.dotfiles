{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "keybinds": {
    "leader": "ctrl+space",
    "app.exit": "ctrl+c,<leader>q",
    "command.palette.show": "ctrl+p",
    "prompt.editor": "<leader>e",
    "theme.switch": "<leader>t",
    "session.sidebar.toggle": "<leader>b",
    "session.toggle.scrollbar": "<leader>B",
    "opencode.status": "<leader>s",
    "session.export": "none",
    "session.new": "<leader>n",
    "session.list": "<leader>l",
    "session.timeline": "none",
    "session.fork": "none",
    "session.rename": "<leader>r",
    "session.share": "none",
    "session.unshare": "none",
    "session.interrupt": "escape",
    "session.compact": "<leader>c",
    "session.parent": "<leader>up",
    "model.list": "<leader>m",
    "model.cycle_recent": "none",
    "model.cycle_recent_reverse": "none",
    "model.cycle_favorite": "none",
    "model.cycle_favorite_reverse": "none",
    "agent.list": "<leader>a",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "variant.cycle": "ctrl+t",
    "session.line.up": "ctrl+up",
    "session.line.down": "ctrl+down",
    "session.half.page.up": "ctrl+shift+up",
    "session.half.page.down": "ctrl+shift+down",
    "session.first": "ctrl+shift+alt+up",
    "session.last": "ctrl+shift+alt+down",
    "session.message.next": "ctrl+alt+down",
    "session.message.previous": "ctrl+alt+up",
    "session.messages_last_user": "none",
    "messages.copy": "<leader>y",
    "session.undo": "ctrl+alt+a",
    "session.redo": "ctrl+alt+d",
    "prompt.clear": "none",
    "prompt.paste": "none",
    "input.submit": "return",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.move.left": "left",
    "input.move.right": "right",
    "input.move.up": "up",
    "input.move.down": "down",
    "input.select.left": "shift+left",
    "input.select.right": "shift+right",
    "input.select.up": "shift+up",
    "input.select.down": "shift+down",
    "input.line.home": "none",
    "input.line.end": "none",
    "input.select.line.home": "none",
    "input.select.line.end": "none",
    "input.visual.line.home": "none",
    "input.visual.line.end": "none",
    "input.select.visual.line.home": "none",
    "input.select.visual.line.end": "none",
    "input.buffer.home": "none",
    "input.buffer.end": "none",
    "input.select.buffer.home": "none",
    "input.select.buffer.end": "none",
    "input.delete.line": "none",
    "input.delete.to.line.end": "none",
    "input.delete.to.line.start": "none",
    "input.backspace": "backspace",
    "input.delete": "none",
    "input.undo": "alt+a",
    "input.redo": "alt+d",
    "input.word.forward": "ctrl+right",
    "input.word.backward": "ctrl+left",
    "input.select.word.forward": "ctrl+shift+right",
    "input.select.word.backward": "ctrl+shift+left",
    "input.delete.word.forward": "none",
    "input.delete.word.backward": "ctrl+backspace",
    "prompt.history.previous": "up",
    "prompt.history.next": "down",
    "terminal.suspend": "ctrl+z",
    "terminal.title.toggle": "none"
  },
  "scroll": {
    "speed": 1,
    "acceleration": true
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
